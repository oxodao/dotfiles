{
    "include": ["~/.config/waybar/config"],
    "height": 32,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{value}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "sway/window": {
        "max-length": 50,
        "all-outputs": false
    }
}
